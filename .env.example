# Strapi backend
NEXT_PUBLIC_STRAPI_URL=https://cms.fxnstudio.com
STRAPI_API_TOKEN=
# Token with CREATE permission on commerce-price-alert (price-drop alerts).
# Falls back to STRAPI_API_TOKEN if unset. See PRICE_ALERTS.md.
STRAPI_WRITE_TOKEN=

# Public site URL (used for canonicals, sitemap, RSS, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.bestlooking.skin

# Default Amazon Associates tag — appended to amzn.to / amazon.* links missing a tag
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# Contact form email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=hello@bestlooking.skin
CONTACT_FROM_EMAIL=

# Google Analytics 4 measurement id. Loaded only after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Scheduled publishing. Posts whose `publishedAt` is in the future are hidden
# from every listing, the sitemap, the RSS feed and their own URL until that
# time passes. Set to 1 in a preview deployment to see the queue; leave unset
# in production. Server-side only -- do not rename this to NEXT_PUBLIC_*, or
# the queue becomes visible to anyone reading the client bundle.
SHOW_SCHEDULED_POSTS=
