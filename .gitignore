node_modules
.next
.env
.env.local
.env.production
*.tsbuildinfo
next-env.d.ts

# Local build/run
.env.local
preview.log

# Backup copies of env files -- ".env.local" alone does not match
# ".env.local.bak-20260814", which sat untracked but committable.
.env*.bak*
.env.local.*

# Scraper output, not source.
#
# data/iherb-flash-deals.json is written into this tree by nxt.discount's
# scripts/fetch-iherb-flash-deals.mjs, so on the deployment host it is modified
# whenever that scraper runs -- and deploy.sh refuses a dirty tree, which made
# every deploy need --allow-dirty. Tracking a file that another process rewrites
# is the actual bug; ignoring it is the fix.
#
# Safe to ignore: lib/iherb-deals.ts returns null when the file is absent and
# the widget simply does not render, by design ("must never fail a build").
data/iherb-flash-deals.json

# Strapi image mirror, generated by scripts/migrate-cms-images.mjs.
#
# Running that script drops 5 files per post (original + 4 sizes) into the
# working tree, and on the deploy host the working tree IS production -- so
# deploy.sh refuses a dirty tree and every mirror run blocks the next deploy.
#
# Ignoring the directory does NOT untrack the files already committed here:
# roughly 30 of them are referenced by POST_COVER_OVERRIDES in lib/strapi.ts and
# keep working exactly as before. It only stops NEW generated files appearing as
# untracked. To commit a new one deliberately: git add -f <path>.
public/cms-uploads/

# Cover manifest written by scripts/generate-post-cover.mjs, read at runtime by lib/strapi.ts.
# Rewritten whenever a cover is generated, so tracking it would leave the tree dirty (see above).
data/generated-covers.json
